      "fast": 140,
      "base": 220,
      "slow": 380,
      "long": 460,
      "entrance": 520,
      "entranceStep": 60,
      "countUp": 900,
      "bars": 800,
      "barStep": 70,
      "shine": 700,
      "ping": 1600
    },
    "ambient": {
      "speedPattern": 30000,
      "plateSpin": 40000,
      "dialSweep": 8000,
      "pulse": 1600
    }
  },
  "ornamentOpacity": {
    "heroPattern": 0.1,
    "heroPlate": 0.3,
    "loginPattern": 0.12,
    "loginPlate": 0.32,
    "emptyDial": 1,
    "appHeaderPattern": 0.1
