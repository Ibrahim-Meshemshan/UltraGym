    "light": {
      "hover": "0 8px 24px rgba(26,26,23,.08)",
      "float": "0 24px 60px rgba(26,26,23,.16)"
    },
    "dark": {
      "hover": "0 8px 24px rgba(0,0,0,.35)",
      "float": "0 24px 60px rgba(0,0,0,.5)"
    }
  },
