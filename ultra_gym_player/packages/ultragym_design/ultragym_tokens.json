  },
  "type": {
    "displayXl": {
      "family": "Changa",
      "size": 48,
      "lineHeight": 56,
      "weight": 800,
      "use": "ترحيب كبير، شاشة البدء، أرقام البوستات"
    },
    "displayMd": {
      "family": "Changa",
      "size": 32,
      "lineHeight": 42,
      "weight": 700,
      "use": "تحية البانر، عنوان حالة فارغة أو نجاح"
    },
    "h1": {
      "family": "Readex Pro",
      "size": 24,
      "lineHeight": 36,
      "weight": 600,
      "use": "عنوان الصفحة"
    },
    "h2": {
      "family": "Readex Pro",
      "size": 19,
      "lineHeight": 30,
      "weight": 600,
      "use": "عنوان قسم أو نافذة"
    },
    "h3": {
      "family": "Readex Pro",
      "size": 16,
      "lineHeight": 26,
      "weight": 600,
      "use": "عنوان بطاقة"
    },
    "stat": {
      "family": "Changa",
      "size": 30,
      "lineHeight": 36,
      "weight": 700,
      "use": "رقم الإحصائية"
    },
    "bodyLg": {
      "family": "Readex Pro",
      "size": 15,
      "lineHeight": 26,
      "weight": 400,
      "use": "نص الموبايل"
    },
    "body": {
      "family": "Readex Pro",
      "size": 14,
      "lineHeight": 24,
      "weight": 400,
      "use": "النص الافتراضي"
    },
    "label": {
      "family": "Readex Pro",
      "size": 12.5,
      "lineHeight": 20,
      "weight": 500,
      "use": "الأزرار والتسميات"
    },
    "caption": {
      "family": "Readex Pro",
      "size": 11.5,
      "lineHeight": 18,
      "weight": 400,
      "use": "النص المساعد (أصغر حجم)"
